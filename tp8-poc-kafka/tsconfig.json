{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["apps/*/src/**/*.ts", "libs/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/demo-ui"]
}
